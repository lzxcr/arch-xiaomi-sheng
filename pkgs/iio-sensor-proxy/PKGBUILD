# Maintainer: Jacobi Lie <jssnlzxcr@gmail.com>
pkgname=iio-sensor-proxy
pkgver=3.9
pkgrel=6
pkgdesc="IIO sensors to D-Bus proxy with Qualcomm SSC support patches"
arch=('aarch64')
url="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy"
license=('GPL-2.0-or-later')
depends=('glib2' 'systemd' 'libgudev' 'polkit' 'dbus' 'libssc')
makedepends=('devtools' 'meson' 'ninja' 'pkgconf')
source=("${pkgname}-${pkgver}.tar.gz::${url}/-/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('af5edd307dcfa52dc3a242d13b7cc756e90a71640caf332efbad960e21649ae4')

build() {
  cd "${pkgname}-${pkgver}"
  arch-meson output \
    -Db_lto=true \
    -Dssc-support=enabled \
    -Dsystemdsystemunitdir=/usr/lib/systemd/system
  meson compile -C output
}

package() {
  cd "${pkgname}-${pkgver}"
  DESTDIR="${pkgdir}" meson install --no-rebuild -C output
}