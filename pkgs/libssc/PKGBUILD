# Maintainer: Jacobi Lie <jssnlzxcr@gmail.com>
pkgname=libssc
pkgver=0.4.4
pkgrel=1
pkgdesc="Library to expose Qualcomm Sensor Core sensors"
arch=('aarch64' 'x86_64')
url="https://codeberg.org/DylanVanAssche/libssc"
license=('GPL-3.0-or-later')
depends=('glib2' 'protobuf-c' 'libqmi')
makedepends=('devtools' 'meson' 'ninja' 'pkgconf' 'protobuf')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('716d6bd6b34d2d753060c6b54c9a87e34fae75b724c763bf9ef487efa3621587')

build() {
  arch-meson "${pkgname}" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
  rm -rf "${pkgdir}/usr/lib/installed-tests"
}
