# Maintainer: Jacobi Lie <jssnlzxcr@gmail.com>
pkgname=linux-firmware-sheng
pkgver=20260723
pkgrel=1
pkgdesc="Firmware files for Xiaomi Pad 6S Pro 12.4 (SM8550-AB)"
arch=('aarch64')
url="https://github.com/ianchb/sheng-firmware"
license=('custom:proprietary')
conflicts=('linux-firmware-atheros' 'linux-firmware-qcom')
provides=('linux-firmware-atheros' 'linux-firmware-qcom' 'linux-firmware-cirrus')
options=('!strip')
source=("git+https://github.com/ianchb/sheng-firmware.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}/sheng-firmware"
    install -d "${pkgdir}/usr/lib/firmware"
    cp -dr --no-preserve=ownership * "${pkgdir}/usr/lib/firmware/"
    chown -R root:root "${pkgdir}"
    find "${pkgdir}/usr/lib/firmware" -type d -exec chmod 755 {} +
    find "${pkgdir}/usr/lib/firmware" -type f -exec chmod 644 {} +
}