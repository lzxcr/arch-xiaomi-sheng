# Maintainer: Jacobi Lie <jssnlzxcr@gmail.com>
pkgname=fastrpc
pkgver=1.0.6
pkgrel=1
pkgdesc="Qualcomm FastRPC library and daemons for CPU-DSP communication"
arch=('aarch64' 'x86_64')
url="https://github.com/qualcomm/fastrpc"
license=('BSD-3-Clause')
depends=('systemd' 'libyaml' 'libbsd')
makedepends=('autoconf' 'automake' 'libtool' 'pkgconf')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        "files.tar.gz")
sha256sums=('SKIP'
            'SKIP')

prepare() {
  cd "${pkgname}-${pkgver}"
  autoreconf -fiv
}

build() {
  cd "${pkgname}-${pkgver}"
  ./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
  install -Dm644 LICENSE.txt "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/adsprpcd_sensorspd.service" "${pkgdir}/usr/lib/systemd/system/adsprpcd_sensorspd.service"
}