# Maintainer: Jacobi Lie <jssnlzxcr@gmail.com>
pkgname=xiaomi-sheng-keyboard-helper
pkgver=0.2.0
pkgrel=1
pkgdesc="Keyboard helper for Xiaomi Sheng (Pad 6S Pro 12.4)"
arch=('aarch64')
url="https://github.com/ianchb/xiaomi-sheng-keyboard-helper"
license=('Apache-2.0')
depends=('glibc' 'glib2' 'systemd')
makedepends=('gcc' 'make' 'pkgconf')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        "files.tar.gz")
sha256sums=('b7c2bf24bb2de69b7db7a89a9b6ef8c21b95b390897090850283789ea466ab46'
            'SKIP')

prepare() {
  cd "${pkgname}-${pkgver}"
  sed -i "s|/usr/libexec/|/usr/lib/${pkgname}/|g" Makefile
}

build() {
  cd "${pkgname}-${pkgver}"
  make all
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install

  install -Dm0644 "${srcdir}/xiaomi-sheng-keyboard-helper-angle.service" \
    "${pkgdir}/usr/lib/systemd/system/xiaomi-sheng-keyboard-helper-angle.service"
  install -Dm0644 "${srcdir}/xiaomi-sheng-keyboard-helper-micmute.service" \
    "${pkgdir}/usr/lib/systemd/user/xiaomi-sheng-keyboard-helper-micmute.service"

  install -Dm0644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  if [ -f packaging/debian/copyright ]; then
    install -Dm0644 packaging/debian/copyright "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  fi
}