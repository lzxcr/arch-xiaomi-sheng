# Maintainer: Jacobi Lie <jssnlzxcr@gmail.com>
pkgname=xiaomi-sheng-devauth
_pkgname=sheng_devauth
pkgver=r5.bac03b5
pkgrel=1
pkgdesc="Keyboard authentication daemon for Xiaomi devices"
arch=('aarch64')
url="https://github.com/ianchb/sheng_devauth"
license=('custom')
depends=('systemd')
makedepends=('git' 'make' 'gcc')
source=("git+https://github.com/ianchb/sheng_devauth.git")
sha256sums=('SKIP')

pkgver() {
  cd "${_pkgname}"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "${_pkgname}"
  make
}

package() {
  cd "${_pkgname}"
  install -Dm755 xiaomi_devauth "${pkgdir}/usr/bin/xiaomi_devauth"
  if [ -f sheng-devauth.service ]; then
    install -Dm644 sheng-devauth.service "${pkgdir}/usr/lib/systemd/system/sheng-devauth.service"
  fi
}