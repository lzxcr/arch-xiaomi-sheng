# Maintainer: Jacobi Lie <jssnlzxcr@gmail.com>
pkgname=hexagonrpc
pkgver=r211.516a46c
pkgrel=1
pkgdesc="Qualcomm Hexagon DSP FastRPC userspace library and daemon"
arch=('aarch64')
url="https://github.com/lzxcr/hexagonrpc"
license=('GPL-3.0-or-later')
depends=('glibc' 'systemd')
makedepends=('meson' 'ninja' 'pkgconf' 'json-c' 'git')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${pkgname}"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "${pkgname}"
  arch-meson build
  meson compile -C build
}

package() {
  cd "${pkgname}"

  # meson install — 忽略 man symlink 脚本的 DESTDIR bug
  # (install-man-symlinks.sh 写 /usr/share/man/ 而非 ${pkgdir}/usr/share/man/)
  DESTDIR="${pkgdir}" meson install -C build 2>&1 || true

  # 手工补创建 man 符号链接
  local mandir="${pkgdir}/usr/share/man/man8"
  for name in adsp adsp-audiopd adsp-sensorspd cdsp sdsp; do
    ln -sf hexagonrpcd.8 "${mandir}/hexagonrpcd-${name}.8" 2>/dev/null || true
  done

  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
