# Maintainer: Jacobi Lie <jssnlzxcr@gmail.com>
pkgname=xiaomi-sheng-sensors
pkgver=20260723
pkgrel=2
pkgdesc="Proprietary sensor configuration files for Xiaomi Pad 6S Pro 12.4 (sheng)"
arch=('aarch64')
url="https://github.com/ianchb/debian-sheng"
license=('custom')
options=('!strip')
depends=('hexagonrpc' 'iio-sensor-proxy')
source=("files.tar.gz")
sha256sums=('4c90c4ee5f4cdbbc4b08fc243542c9a7c51eec59c2a3e0f3060f5e650d2a50e9')

package() {
  cp -dr --no-preserve=ownership "${srcdir}/usr" "${pkgdir}/"

  find "${pkgdir}/usr/share/qcom" -type d -exec chmod 755 {} +
  find "${pkgdir}/usr/share/qcom" -type f -exec chmod 644 {} +

  install -Dm644 "${srcdir}/81-sheng-ssc-sensors.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/81-sheng-ssc-sensors.rules"
  install -Dm644 "${srcdir}/xiaomi-sheng-sensors.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/xiaomi-sheng-sensors.conf"
}
