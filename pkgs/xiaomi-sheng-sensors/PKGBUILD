# Maintainer: Jacobi Lie <jssnlzxcr@gmail.com>
pkgname=xiaomi-sheng-sensors
pkgver=20260723
pkgrel=1
pkgdesc="Proprietary sensor configuration files for Xiaomi Mi Pad 6s Pro"
arch=('aarch64')
url="https://github.com/qualcomm/fastrpc"
license=('custom')
depends=('iio-sensor-proxy')
source=("files.tar.gz")
sha256sums=('SKIP')

package() {
  # 直接拷贝的数据部分（传感器配置文件）
  cp -dr --no-preserve=ownership "${srcdir}/usr/share" "${pkgdir}/"

  # 需要安装的系统集成文件
  install -Dm644 "${srcdir}/lib/systemd/system/iio-sensor-proxy.service.d/10-sheng-sensors.conf" \
    "${pkgdir}/usr/lib/systemd/system/iio-sensor-proxy.service.d/10-sheng-sensors.conf"
  install -Dm644 "${srcdir}/lib/udev/rules.d/81-sheng-ssc-sensors.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/81-sheng-ssc-sensors.rules"
}
