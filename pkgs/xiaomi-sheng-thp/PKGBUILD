# Maintainer: Jacobi Lie <jssnlzxcr@gmail.com>
pkgname=xiaomi-sheng-thp
pkgver=0.3.9
pkgrel=1
pkgdesc="NT36532E userspace touch processor for Xiaomi Sheng"
arch=('aarch64')
url="https://github.com/ianchb/xiaomi-sheng-thp"
license=('Apache-2.0')

# 0.3.9 起链接 libssc（Focus Pen Pro posture 路径）与 glib2
depends=(
  'bluez'
  'glibc'
  'gcc-libs'
  'glib2'
  'libssc'
  'systemd'
)
optdepends=(
  'xiaomi-pen-status: Xiaomi Focus Pen status reporting'
)
makedepends=(
  'gcc'
  'make'
  'pkgconf'
  'glib2'
  'libssc'
)

source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        "files.tar.gz")
sha256sums=('0f85033dc4119022537200540893c466b3778c3f8ca2250440a9d9f93e61448b'
            'd0d612be50566037e223b1b25a18edfb3044fd78cd06487213676bc80883ed9c')

build() {
  cd "${pkgname}-${pkgver}"
  make clean all
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" LIBEXECDIR=/usr/lib/xiaomi-sheng-thp install

  install -Dm0644 "${srcdir}/xiaomi-sheng-thp.service" \
    "${pkgdir}/usr/lib/systemd/system/xiaomi-sheng-thp.service"
}
