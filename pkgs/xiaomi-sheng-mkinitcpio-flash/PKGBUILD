# Maintainer: Jacobi Lie <jssnlzxcr@gmail.com>
pkgname=xiaomi-sheng-mkinitcpio-flash
pkgver=1.0.0
pkgrel=1
pkgdesc="mkinitcpio post-generation hook: build boot.img and flash to inactive A/B slot"
arch=('any')
url="https://github.com/ianchb/arch-xiaomi-sheng"
license=('GPL-2.0-only')
depends=('android-tools' 'sed' 'coreutils' 'mkinitcpio')
source=("files.tar.gz")
sha256sums=('SKIP')

package() {
  install -Dm755 "${srcdir}/xiaomi-sheng-flash-boot" \
    "${pkgdir}/usr/bin/xiaomi-sheng-flash-boot"
  install -Dm644 "${srcdir}/xiaomi-sheng-mkinitcpio-flash.conf" \
    "${pkgdir}/etc/mkinitcpio.d/xiaomi-sheng-mkinitcpio-flash.conf"
}
