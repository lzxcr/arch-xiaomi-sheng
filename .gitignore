# 构建输出
/out/

# 构建临时目录（makepkg 生成的编译/打包中间文件）
**/src/
**/pkg/

# 构建产物（makepkg 输出的 .pkg.tar.* 包文件）
*.pkg.tar.*

# 本地打包的源文件（由 package-files.sh 生成）
files.tar.gz

# 下载的远程源码包（非本地维护的源文件）
pkgs/*/*.tar.gz
pkgs/*/*.deb
pkgs/*/*.deb.part

# 嵌入式 git 仓库（makepkg clone 到 $srcdir，勿提交）
pkgs/*/src/*/

# 历史遗留：包目录下的手动上游克隆（.git 内部文件，勿提交）
pkgs/*/hexagonrpc/
pkgs/*/sheng-firmware/
pkgs/*/sheng_devauth/

# 日志
*.log
