#!/bin/bash
#
# bootflash — mkinitcpio post-generation hook
# Builds boot.img from /boot/loader/entries/arch.conf. On an installed device
# it also flashes boot_a and boot_b; image builders set BOOTFLASH_NO_FLASH=1.
#
set -euo pipefail

ENTRY_CONF="/boot/loader/entries/arch.conf"
BOOT_IMG="/boot/boot.img"

if [ ! -f "$ENTRY_CONF" ]; then
    echo "==> [bootflash] $ENTRY_CONF not found; skipping boot image generation"
    exit 0
fi

echo "==> [bootflash] Parsing $ENTRY_CONF ..."

CONF_LINUX=$(sed -n 's/^linux[[:space:]]\+\(.*\)/\1/p' "$ENTRY_CONF" | xargs)
CONF_INITRD=$(sed -n 's/^initrd[[:space:]]\+\(.*\)/\1/p' "$ENTRY_CONF" | xargs)
CONF_DTB=$(sed -n 's/^devicetree[[:space:]]\+\(.*\)/\1/p' "$ENTRY_CONF" | xargs)
CONF_OPTIONS=$(sed -n 's/^options[[:space:]]\+\(.*\)/\1/p' "$ENTRY_CONF" | xargs)

KERNEL_PATH="/boot/${CONF_LINUX#/}"
RAMDISK_PATH="/boot/${CONF_INITRD#/}"
DTB_PATH="/boot/${CONF_DTB#/}"

echo "  Kernel:    $KERNEL_PATH"
echo "  Initramfs: $RAMDISK_PATH"
echo "  DTB:       $DTB_PATH"

if [ ! -f "$KERNEL_PATH" ]; then
    echo "ERROR: Kernel not found: $KERNEL_PATH" >&2
    exit 1
fi
if [ ! -f "$RAMDISK_PATH" ]; then
    echo "ERROR: Initramfs not found: $RAMDISK_PATH" >&2
    exit 1
fi

echo "==> Building boot.img ..."

MKBOOTIMG_ARGS=(
    --kernel "$KERNEL_PATH"
    --ramdisk "$RAMDISK_PATH"
    --cmdline "$CONF_OPTIONS"
    --base 0x00000000
    --pagesize 4096
    --header_version 2
    -o "$BOOT_IMG"
)

if [ -n "$CONF_DTB" ] && [ -f "$DTB_PATH" ]; then
    MKBOOTIMG_ARGS+=(--dtb "$DTB_PATH")
fi

mkbootimg "${MKBOOTIMG_ARGS[@]}"

if [ ! -f "$BOOT_IMG" ]; then
    echo "ERROR: mkbootimg failed" >&2
    exit 1
fi

if [ "${BOOTFLASH_NO_FLASH:-0}" = "1" ]; then
    echo "==> [bootflash] BOOTFLASH_NO_FLASH=1; boot.img built without flashing"
    exit 0
fi

echo "==> Flashing boot.img to both A/B slots ..."
for part in boot_a boot_b; do
    TARGET="/dev/disk/by-partlabel/$part"
    if [ -L "$TARGET" ]; then
        echo "  → $TARGET"
        dd if="$BOOT_IMG" of="$TARGET" bs=4M status=progress
    else
        echo "  (skip $TARGET — not found)"
    fi
done
sync
echo "==> [Success] A/B boot partitions updated"
