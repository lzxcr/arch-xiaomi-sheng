[Unit]
Description=Xiaomi sheng keyboard fold angle helper
# Keyboard HID is kernel-only.  This optional fold-angle policy combines the
# nanosic_hinge ABI with libssc and exits successfully when SSC is unavailable.
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/lib/xiaomi-sheng-keyboard-helper/xiaomi-sheng-keyboard-helper --angle
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
