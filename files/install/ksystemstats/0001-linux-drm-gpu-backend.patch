@@ -78,12 +82,50 @@ void LinuxBackend::start()
     }
 
     udev_enumerate_unref(enumerate);
+
+    enumerate = udev_enumerate_new(m_udev);
+    udev_enumerate_add_match_subsystem(enumerate, "drm");
+    udev_enumerate_scan_devices(enumerate);
+
+    devices = udev_enumerate_get_list_entry(enumerate);
+    for (auto entry = devices; entry; entry = udev_list_entry_get_next(entry)) {
+        const char *path = udev_list_entry_get_name(entry);
+        udev_device *drmDevice = udev_device_new_from_syspath(m_udev, path);
+        if (!drmDevice) {
+            continue;
+        }
+        const char *sysname = udev_device_get_sysname(drmDevice);
+
+        const QByteArray name = sysname ? QByteArray(sysname) : QByteArray();
+        const QByteArray cardNumber = name.sliced(sizeof("card") - 1);
+        const bool isPrimaryNode = name.startsWith("card") && !cardNumber.isEmpty()
+            && std::ranges::all_of(cardNumber, [](const char character) {
+                   return std::isdigit(static_cast<unsigned char>(character));
+               });
+        const bool hasPciParent = udev_device_get_parent_with_subsystem_devtype(drmDevice, "pci", nullptr);
+        if (!isPrimaryNode || hasPciParent) {
+            udev_device_unref(drmDevice);
+            continue;
+        }
+
+        const QString gpuId = QStringLiteral("gpu%1").arg(gpuNumber);
+        const QString gpuName = KSysGuard::gpuName(drmDevice, gpuNumber);
+        auto gpu = new LinuxDrmGpu(gpuId, gpuName, drmDevice);
+        gpu->initialize();
+        m_devices.append(gpu);
+        Q_EMIT deviceAdded(gpu);
+        gpuNumber++;
+        udev_device_unref(drmDevice);
+    }
+
+    udev_enumerate_unref(enumerate);
 }
 
 void LinuxBackend::stop()
 {
     qDeleteAll(m_devices);
     udev_unref(m_udev);
