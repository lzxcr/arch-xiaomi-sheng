+static void byte2string(const unsigned char *bytes, size_t len, char *output)
+{
+	static const char hex[] = "0123456789ABCDEF";
+
+	for (size_t i = 0; i < len; i++) {
+		output[i * 2] = hex[bytes[i] >> 4];
+		output[i * 2 + 1] = hex[bytes[i] & 0xf];
+	}
+	output[len * 2] = '\0';
 }
 
