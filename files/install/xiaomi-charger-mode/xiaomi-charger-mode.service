[Unit]
Description=Xiaomi charger mode for sheng
DefaultDependencies=no
ConditionKernelCommandLine=androidboot.mode=charger
Wants=local-fs.target systemd-udev-trigger.service systemd-modules-load.service
After=local-fs.target systemd-udev-trigger.service systemd-modules-load.service plymouth-start.service
Before=basic.target display-manager.service shutdown.target

[Service]
Type=oneshot
TimeoutStartSec=infinity
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/lib/xiaomi-charger-mode/xiaomi-charger-mode

[Install]
WantedBy=sysinit.target
