index 0000000..e223dc1
--- /dev/null
+++ b/crates/hexagonrpc/src/bin/hexagonrpc-probe.rs
@@ -0,0 +1,60 @@
+//! One-shot remote loader probe for a FastRPC session shared by hexagonrpcd.
+//!
+//! SPDX-License-Identifier: GPL-3.0-or-later
+
+use std::process::ExitCode;
+
+use hexagonrpc::{hexagonrpc_fd_from_env, remotectl_close, remotectl_open};
+
+const EXIT_USAGE: u8 = 2;
+const EXIT_LOAD_FAILED: u8 = 1;
+
+fn interface_names() -> Vec<String> {
+    let mut names: Vec<String> = std::env::args().skip(1).collect();
+    if names.is_empty()
+        && let Ok(value) = std::env::var("HEXAGONRPC_PROBE_INTERFACES")
+    {
+        names.extend(
+            value
+                .split([',', ';', ' ', '\t', '\n'])
+                .filter(|name| !name.is_empty())
+                .map(str::to_string),
+        );
+    }
+    names
+}
+
+fn main() -> ExitCode {
+    let Some(fd) = hexagonrpc_fd_from_env() else {
+        eprintln!("hexagonrpc-probe: HEXAGONRPC_FD is missing or invalid");
+        return ExitCode::from(EXIT_USAGE);
+    };
+    let names = interface_names();
+    if names.is_empty() {
+        eprintln!(
+            "hexagonrpc-probe: pass an interface name or set \
+             HEXAGONRPC_PROBE_INTERFACES"
+        );
+        return ExitCode::from(EXIT_USAGE);
+    }
+
+    for name in names {
+        let context = match remotectl_open(fd, &name) {
+            Ok(context) => context,
+            Err(error) => {
+                eprintln!("hexagonrpc-probe: LOAD FAILED {name}: {error}");
+                return ExitCode::from(EXIT_LOAD_FAILED);
+            }
+        };
+        println!(
+            "hexagonrpc-probe: LOAD OK {name} (handle={})",
+            context.handle
+        );
+        if let Err(error) = remotectl_close(&context) {
+            eprintln!("hexagonrpc-probe: CLOSE FAILED {name}: {error}");
+            return ExitCode::from(EXIT_LOAD_FAILED);
+        }
+    }
+
+    ExitCode::SUCCESS
+}
diff --git a/hexagonrpcd/hexagonrpc-probe.8 b/hexagonrpcd/hexagonrpc-probe.8
new file mode 100644
index 0000000..92bcd28
--- /dev/null
+++ b/hexagonrpcd/hexagonrpc-probe.8
@@ -0,0 +1,49 @@
+'\" t
+.TH HEXAGONRPC-PROBE 8 "2026-08" "hexagonrpc v0.6.0" "System Manager's Manual"
+.SH NAME
+hexagonrpc-probe \- verify that a Qualcomm DSP interface can be loaded
+.SH SYNOPSIS
+.B hexagonrpc-probe
+.RI [ interface ... ]
+.SH DESCRIPTION
+hexagonrpc-probe opens and closes each named DSP interface through remotectl.
+It must be launched by
+.BR hexagonrpcd (8)
+with
+.B \-p
+so it inherits the attached FastRPC file descriptor. If no command-line names
+are provided, the comma, semicolon, or whitespace separated value of
+.B HEXAGONRPC_PROBE_INTERFACES
+is used.
+.PP
+A successful open prints
+.B LOAD OK
+with the remote handle. Loader, invocation, and close failures print
+.B FAILED
+and return a non-zero status.
+.SH ENVIRONMENT
+.TP
+.B HEXAGONRPC_FD
+Inherited FastRPC file descriptor. Set by hexagonrpcd.
+.TP
+.B HEXAGONRPC_PROBE_INTERFACES
+Interfaces to probe when no positional argument is present.
+.SH EXIT STATUS
+.TP
+0
+Every interface loaded and closed successfully.
+.TP
+1
+Remote load or close failed.
+.TP
+2
+No valid inherited descriptor or no interface name was provided.
+.SH EXAMPLE
+.nf
+HEXAGONRPC_PROBE_INTERFACES=benchmark \
+  hexagonrpcd -f /dev/fastrpc-cdsp -d cdsp \
+  -p /usr/bin/hexagonrpc-probe
+.fi
+.SH SEE ALSO
+.BR hexagonrpcd (8),
+.BR hexagonrpc (3)
